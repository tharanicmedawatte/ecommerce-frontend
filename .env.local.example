# =============================================================================
# .env.local.example
# Copy this to .env.local and fill in your values.
# NEVER commit .env.local to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# Flask backend URL
# Development: http://localhost:5000
# Production:  https://your-flask-server.com
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000

# -----------------------------------------------------------------------------
# Auth0
# From: https://manage.auth0.com → your Application settings
# -----------------------------------------------------------------------------
AUTH0_SECRET=use-openssl-rand-hex-32-to-generate    # long random string
AUTH0_BASE_URL=http://localhost:3000                  # your Next.js URL
AUTH0_ISSUER_BASE_URL=https://YOUR_DOMAIN.auth0.com  # your Auth0 domain
AUTH0_CLIENT_ID=YOUR_AUTH0_CLIENT_ID
AUTH0_CLIENT_SECRET=YOUR_AUTH0_CLIENT_SECRET

# Auth0 API audience — must match AUTH0_AUDIENCE in Flask .env
AUTH0_AUDIENCE=https://api.yourshop.com

# -----------------------------------------------------------------------------
# Stripe
# From: https://dashboard.stripe.com → Developers → API Keys
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
